{
  "name": "brand-etymology",
  "version": "0.1.0",
  "description": "静态品牌名称词源、读音与文化背景知识网站",
  "homepage": "https://holynova.github.io/brand-etymology/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holynova/brand-etymology.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "build:pages": "GITHUB_PAGES=true astro check && GITHUB_PAGES=true astro build && pagefind --site docs && touch docs/.nojekyll",
    "preview": "astro preview",
    "check": "astro check",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:links": "tsx scripts/check-links.ts",
    "assets:logos": "tsx scripts/generate-logos.ts",
    "test": "npm run content:validate && playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/literata": "5.2.8",
    "@fontsource-variable/source-sans-3": "5.2.9",
    "@iconify-json/logos": "^1.2.11",
    "astro": "7.0.9",
    "simple-icons": "^16.26.0",
    "simple-icons-v10": "npm:simple-icons@^10.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.1",
    "pagefind": "1.5.2",
    "tsx": "latest",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
