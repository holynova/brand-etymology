---
import styles from "../styles/site.module.css";
import { sitePath } from "../lib/paths";

interface Props {
  id: string;
  name: string;
  detail?: boolean;
  compact?: boolean;
}

const { id, name, detail = false, compact = false } = Astro.props;
---
<span class:list={[styles.logoFrame, detail && styles.logoDetail, compact && styles.logoCompact]} aria-hidden="true">
  <img src={sitePath(`/logos/${id}.svg`)} alt="" loading={detail ? "eager" : "lazy"} decoding="async" />
  <span class={styles.srOnly}>{name} 标志</span>
</span>
