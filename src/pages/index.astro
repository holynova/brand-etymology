---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandLogo from "../components/BrandLogo.astro";
import styles from "../styles/site.module.css";
import { countryMeta } from "../lib/taxonomy";
import { sitePath } from "../lib/paths";

const entries = (await getCollection("brands")).sort((a, b) =>
  a.data.country.localeCompare(b.data.country, "zh-CN") || a.data.countryRank - b.data.countryRank
);
const countries = [...new Set(entries.map((entry) => entry.data.country))];
const categories = [...new Set(entries.map((entry) => entry.data.category))];
const confidenceLabel = { confirmed: "已确认", probable: "较可信", disputed: "有争议", pending: "待考证" };
const pendingCount = entries.filter((entry) => entry.data.confidence === "pending").length;
---

<BaseLayout>
  <div class={styles.shell}>
    <section class={styles.hero} aria-labelledby="hero-title">
      <div class={styles.heroCopy}>
        <p class={styles.heroKicker}>英语品牌词源解析</p>
        <h1 id="hero-title" class={styles.heroTitle}><span lang="zh">每一个名字，都从某处借来。</span></h1>
        <p class={styles.heroDeck}>从一个品牌的读音出发，追到它借用的人名、地名、旧词与造词传统。结论旁保留证据等级，让故事可以被核对。</p>
      </div>
      <aside class={styles.heroIndex} aria-label="词条库概览">
        <p class={styles.heroIndexCount}>{entries.length}<span>份命名档案</span></p>
        <p>{entries.length} 条均已重新整理；其中 {pendingCount} 条因命名来源证据不足标记为待考证。</p>
        <ul class={styles.heroKeyList}>
          <li>名称读音</li>
          <li>命名谱系</li>
          <li>来源证据</li>
        </ul>
      </aside>
    </section>

    <section class={styles.searchSection} aria-label="搜索与筛选">
      <div class={styles.searchIntro}>
        <p class={styles.sectionLabel}>检索词条库</p>
        <p>可按品牌原文、中文别名、国家、行业或命名方法定位。卡片底部的状态不会把“尚未核实”伪装成结论。</p>
      </div>
      <div class={styles.searchControls}>
        <form id="search-form" class={styles.searchBar} role="search">
          <input id="search" class={styles.searchInput} type="search" name="q" autocomplete="off" placeholder="搜索 Sony、索尼、ソニー或“神话”" aria-label="搜索词条" />
          <button class={styles.searchButton} type="submit">检索</button>
        </form>
        <div class={styles.filters}>
          <div class={styles.field}>
            <label for="country">国家</label>
            <select id="country" class={styles.select}>
              <option value="">全部国家</option>
              {countries.map((country) => {
                const entry = entries.find((item) => item.data.country === country)!;
                return <option value={country}>{countryMeta[entry.data.countryCode].flag} {country}</option>;
              })}
            </select>
          </div>
          <div class={styles.field}>
            <label for="category">类别</label>
            <select id="category" class={styles.select}>
              <option value="">全部类别</option>
              {categories.map((category) => <option value={category}>{category}</option>)}
            </select>
          </div>
          <div class={styles.field}>
            <label for="sort">排序</label>
            <select id="sort" class={styles.select}>
              <option value="rank">国家内收录顺序</option>
              <option value="name">名称 A–Z</option>
              <option value="year">创立年份</option>
              <option value="confidence">可信度</option>
            </select>
          </div>
        </div>
        <div class={styles.resultMeta} aria-live="polite">
          <span id="result-count">显示 {entries.length} 个词条</span>
          <button id="clear" class={styles.clearButton} type="button">清除条件</button>
        </div>
      </div>
    </section>

    <section id="catalog" class={styles.catalog} aria-label="品牌词条" data-pagefind-ignore>
      {entries.map((entry, index) => {
        const item = entry.data;
        const searchText = [item.name, item.nativeName, item.zhName, ...item.aliases, item.country, item.category, ...item.methods, item.story].join(" ").toLocaleLowerCase();
        return (
          <article
            class={styles.entry}
            data-entry
            data-search={searchText}
            data-country={item.country}
            data-category={item.category}
            data-rank={item.countryRank}
            data-name={item.name}
            data-year={item.founded ?? 9999}
            data-confidence={item.confidence}
            style={`animation-delay:${Math.min(index, 10) * 45}ms`}
          >
            <div class={styles.entryTop}>
              <span class={styles.entryCode}>{item.countryCode}.{String(item.countryRank).padStart(3, "0")}</span>
              <span class={styles.evidenceState} data-level={item.confidence}>{confidenceLabel[item.confidence]}</span>
            </div>
            <div class={styles.brandIdentity}>
              <BrandLogo id={entry.id} name={item.name} />
              <h2 class={styles.entryName}>
                <a href={sitePath(`/brand/${entry.id}/`)}>{item.name}</a>
                <span class={styles.native} lang={item.countryCode === "JP" ? "ja" : item.countryCode === "KR" ? "ko" : "zh"}>{item.nativeName}</span>
              </h2>
            </div>
            <p class={styles.entryStory}>{item.story}</p>
            <div class={styles.entryMeta}>
              <div class={styles.entryTags}>
                <span class={styles.tag}><span class={styles.flag} aria-hidden="true">{countryMeta[item.countryCode].flag}</span>{item.country}</span>
                <span class={styles.tag}>{item.category}</span>
                <span class={styles.tag}>{item.methods[0]}</span>
              </div>
              <a class={styles.cardLink} href={sitePath(`/brand/${entry.id}/`)}>查看档案 <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        );
      })}
      <p id="empty" class={styles.empty} hidden>没有找到这个名字。试试别名、原文写法或命名方法。</p>
    </section>
  </div>

  <script>
    const form = document.querySelector<HTMLFormElement>("#search-form");
    const input = document.querySelector<HTMLInputElement>("#search");
    const country = document.querySelector<HTMLSelectElement>("#country");
    const category = document.querySelector<HTMLSelectElement>("#category");
    const sort = document.querySelector<HTMLSelectElement>("#sort");
    const clear = document.querySelector<HTMLButtonElement>("#clear");
    const catalog = document.querySelector<HTMLElement>("#catalog");
    const count = document.querySelector<HTMLElement>("#result-count");
    const empty = document.querySelector<HTMLElement>("#empty");
    const entries = Array.from(document.querySelectorAll<HTMLElement>("[data-entry]"));
    const confidenceOrder = { confirmed: 0, probable: 1, disputed: 2, pending: 3 };

    const syncFromUrl = () => {
      const params = new URLSearchParams(location.search);
      if (input) input.value = params.get("q") ?? "";
      if (country) country.value = params.get("country") ?? "";
      if (category) category.value = params.get("category") ?? "";
      if (sort) sort.value = params.get("sort") ?? "rank";
    };

    const apply = () => {
      if (!input || !country || !category || !sort || !catalog || !count || !empty) return;
      const query = input.value.trim().toLocaleLowerCase();
      const words = query.split(/\s+/).filter(Boolean);
      let visible = 0;

      entries.forEach((entry) => {
        const text = entry.dataset.search ?? "";
        const matches = words.every((word) => text.includes(word))
          && (!country.value || entry.dataset.country === country.value)
          && (!category.value || entry.dataset.category === category.value);
        entry.hidden = !matches;
        if (matches) visible += 1;
      });

      const sorted = [...entries].sort((a, b) => {
        if (sort.value === "name") return (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "", "en");
        if (sort.value === "year") return Number(a.dataset.year) - Number(b.dataset.year);
        if (sort.value === "confidence") return confidenceOrder[a.dataset.confidence as keyof typeof confidenceOrder] - confidenceOrder[b.dataset.confidence as keyof typeof confidenceOrder];
        return (a.dataset.country ?? "").localeCompare(b.dataset.country ?? "", "zh-CN") || Number(a.dataset.rank) - Number(b.dataset.rank);
      });
      sorted.forEach((entry) => catalog.insertBefore(entry, empty));
      count.textContent = `显示 ${visible} 个词条`;
      empty.hidden = visible !== 0;

      const params = new URLSearchParams();
      if (query) params.set("q", input.value.trim());
      if (country.value) params.set("country", country.value);
      if (category.value) params.set("category", category.value);
      if (sort.value !== "rank") params.set("sort", sort.value);
      history.replaceState(null, "", `${location.pathname}${params.size ? `?${params}` : ""}${location.hash}`);
    };

    form?.addEventListener("submit", (event) => { event.preventDefault(); apply(); });
    input?.addEventListener("input", apply);
    country?.addEventListener("change", apply);
    category?.addEventListener("change", apply);
    sort?.addEventListener("change", apply);
    clear?.addEventListener("click", () => {
      if (input) input.value = "";
      if (country) country.value = "";
      if (category) category.value = "";
      if (sort) sort.value = "rank";
      apply();
      input?.focus();
    });
    syncFromUrl();
    apply();
  </script>
</BaseLayout>
